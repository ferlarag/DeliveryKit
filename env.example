# Copy to .env and replace the password and token before starting Compose.
DATABASE_NAME=webhooks
DATABASE_USER=webhooks
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://db:5432/webhooks
ADMIN_TOKEN=replace-with-a-long-random-admin-token
APP_PORT=8080
ALLOW_HTTP_TARGETS=false
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4

# For a separate worker container, set WORKER_ENABLED=false on the API.
# The worker service in compose.yaml always enables processing.
