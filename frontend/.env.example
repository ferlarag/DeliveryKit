# Copy to .env for local frontend development.
# The Vite dev server proxies API requests to this address.
DELIVERYKIT_API_TARGET=http://localhost:8080

# Optional: set VITE_API_ORIGIN in .env.development.local if the webhook URL
# displayed in the UI needs a different public origin. VITE_ values are
# embedded in browser assets, so never put credentials in them.
